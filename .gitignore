# =============================================================================
# .gitignore — projetos de ciência de dados (alinhado ao CLAUDE.md).
# Regra geral: dados e modelos são versionados por DVC/MLflow, não pelo Git.
# COMMITADOS de propósito: uv.lock, .env.example, .secrets.baseline,
# .vscode/settings.json, .vscode/launch.json, arquivos .dvc e .gitkeep.
# =============================================================================

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Ambientes / uv --------------------------------------------------------
.venv/
venv/
env/
# uv.lock DEVE ser commitado (reprodutibilidade) — não ignorar.

# --- Segredos / variáveis de ambiente --------------------------------------
.env
.env.*
!.env.example
# .secrets.baseline é commitado (usado pelo detect-secrets) — não ignorar.

# --- Dados (arquitetura medalhão; versionados por DVC) ----------------------
# Ancorado na raiz: "data/" sem âncora também esconderia src/data/.
/data/bronze/*
/data/silver/*
/data/gold/*
# Mantém a estrutura de pastas, o manifesto do bronze e os ponteiros do DVC:
!/data/**/.gitkeep
!/data/**/*.dvc
!/data/bronze/manifest.json

# --- Modelos / experimentos ------------------------------------------------
/models/*
!/models/**/.gitkeep
!/models/**/*.dvc
mlruns/
mlartifacts/
*.joblib
*.pkl
*.pt
*.onnx
*.h5

# Relatórios: métricas (reports/metrics/*.json) e figuras são COMMITADAS — o README
# cita esses arquivos como fonte dos números. Apenas o monitoramento é ignorado.
reports/monitoring/*


# --- DVC -------------------------------------------------------------------
/.dvc/cache
/.dvc/tmp
/.dvc/plots
# .dvc/config e os arquivos *.dvc são commitados.

# --- Logs ------------------------------------------------------------------
logs/
*.log

# --- Testes / cobertura / lint ---------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/
.hypothesis/

# --- Documentação (build do MkDocs) ----------------------------------------
site/

# --- Notebooks -------------------------------------------------------------
.ipynb_checkpoints/

# --- Profiling -------------------------------------------------------------
*.speedscope
*.memray
profile.html
profile.json

# --- Sistema operacional ---------------------------------------------------
.DS_Store
Thumbs.db

# --- IDEs ------------------------------------------------------------------
.idea/
# Do VSCode, mantém apenas os arquivos de configuração compartilhados:
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Arquivos do Claude ----------------------------------------------------
CLAUDE.md
CLAUDE.local.md
.claude/
.mcp.json
