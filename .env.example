# =============================================================================
# .env.example — variáveis de ambiente (copie para .env e preencha).
# NUNCA commite o arquivo .env real. Apenas segredos e URIs de infraestrutura.
# =============================================================================

# Backend do MLflow: sempre banco de dados, nunca o file store (./mlruns).
# Sobrescreve experiment.tracking_uri de configs/config.yaml (delimitador "__" do pydantic-settings).
EXPERIMENT__TRACKING_URI=sqlite:///mlruns/mlflow.db

# Modelo servido pela API: caminho do arquivo do modelo (padrão local; no Docker, volume montado).
# Sobrescreve api.model_path de configs/deploy.yaml.
# MODEL_URI=models/fraud_model.joblib   # no Docker o padrão é /models/fraud_model.joblib (volume)

# Semente global (opcional; sobrescreve o padrão do config.yaml).
RANDOM_SEED=42

# Docker Compose: banco do MLflow (use valores próprios; não reutilize senhas).
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=troque-esta-senha

# Credenciais de remote do DVC (ex.: S3) — preencha apenas se aplicável.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
